<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Yeh transparent background track ko height dega aur padding create karega -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <size 
                android:width="32dp" 
                android:height="32dp" />
        </shape>
    </item>
    
    <!-- Yeh actual white thumb hai, jisme chaaro taraf 4dp ka inset (margin) hai -->
    <item 
        android:top="4dp" 
        android:bottom="4dp" 
        android:left="4dp" 
        android:right="4dp">
        <shape android:shape="oval">
            <!-- White color for the circular thumb -->
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>