<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:tint="#000000"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="About Us"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ScrollView Added Here for Floating Window Support -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_bar"
        android:layout_above="@id/tv_footer"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- App Info Container -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardMaxElevation="3dp">

                <!-- Removed paddingBottom to allow background elements to touch the bottom edges -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false">

                    <!-- PATTERN: Top-Left Black Circles -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="top|start">
                        
                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#222222"
                            android:translationX="-12dp"
                            android:translationY="-12dp" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#666666"
                            android:translationX="32dp"
                            android:translationY="28dp" />
                            
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="top|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#AAAAAA"
                            android:translationX="48dp"
                            android:translationY="4dp" />
                    </FrameLayout>

                    <!-- PATTERN: Bottom-Left Black Circles -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom|start">
                        
                        <View
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#222222"
                            android:translationX="-12dp"
                            android:translationY="12dp" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#666666"
                            android:translationX="32dp"
                            android:translationY="-28dp" />
                            
                        <View
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#AAAAAA"
                            android:translationX="48dp"
                            android:translationY="-4dp" />
                    </FrameLayout>

                    <!-- PATTERN: Top-Right Yellow Circles -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="top|end">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFF0B3"
                            android:translationX="16dp"
                            android:translationY="-16dp" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFF7D6"
                            android:translationX="-28dp"
                            android:translationY="28dp" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFFAEB"
                            android:translationX="-64dp"
                            android:translationY="4dp" />
                    </FrameLayout>

                    <!-- PATTERN: Bottom-Right Yellow Circles -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="bottom|end">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFF0B3"
                            android:translationX="16dp"
                            android:translationY="16dp" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFF7D6"
                            android:translationX="-28dp"
                            android:translationY="-28dp" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_circle_menu"
                            android:backgroundTint="#FFFAEB"
                            android:translationX="-64dp"
                            android:translationY="-4dp" />
                    </FrameLayout>

                    <!-- Center Content -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp">

                        <!-- Fixed App Icon Box -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="1dp">
                            
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/app_icon" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="NotNote"
                            android:textColor="#000000"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Dynamic Version ID -->
                        <TextView
                            android:id="@+id/tv_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="V1.0"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Help Section Heading -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="8dp"
                android:text="Help"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 1. Send Feedback (Top Capsule Design) -->
            <LinearLayout
                android:id="@+id/btn_send_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_capsule_top"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Left Icon Circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#FFF0B3"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">
                    
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mail"
                        android:tint="#000000" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="send feedback"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Privacy Policy (Bottom Capsule Design) -->
            <LinearLayout
                android:id="@+id/btn_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule_bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Left Icon Circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardBackgroundColor="#FFF0B3"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">
                    
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield"
                        android:tint="#000000" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="privacy policy"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer Copyright -->
    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="© 2026 Santosh Kumar Rana"
        android:textColor="#757575"
        android:textSize="14sp" />

</RelativeLayout>