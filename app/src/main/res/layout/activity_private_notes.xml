<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:focusableInTouchMode="true">

    <!-- Solid Header Container -->
    <LinearLayout
        android:id="@+id/header_container_private"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:outlineAmbientShadowColor="#00000000"
        android:outlineSpotShadowColor="#00000000"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:id="@+id/top_bar_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingHorizontal="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btn_back_private"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@drawable/ic_back"
                    android:tint="#000000" />

                <!-- Private Title (Shifted Left) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Private Vault"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- EMPTY STATE CONTAINER (No Private Notes) -->
    <LinearLayout
        android:id="@+id/empty_state_private"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container_private"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
            
        <!-- Updated Illustration Here -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_empty_vault" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Vault is empty"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Notes you make private will appear here"
            android:textColor="#999999"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Recycler View for Private Notes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_private_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container_private"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="88dp" />

</RelativeLayout>