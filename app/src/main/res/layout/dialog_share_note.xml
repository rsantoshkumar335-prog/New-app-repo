<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Sheet ke liye transparent parent with padding for floating effect -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#00000000"
    android:padding="16dp"> <!-- Yahan padding add ki gayi hai left/right/bottom space ke liye -->

    <!-- Main White Bottom Sheet Container jisme top corners highly curved hain -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Drag Handle (Fixed with CardView) -->
            <androidx.cardview.widget.CardView
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#D1D1D1"
                app:cardCornerRadius="2.5dp"
                app:cardElevation="0dp" />

            <!-- ===================== DOWNLOAD SECTION ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <!-- Large Light Gray Squarish Capsule -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F2F2F2"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:gravity="center">

                    <!-- Medium White Capsule for PDF Download -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_download_pdf_action"
                        android:layout_width="165dp"
                        android:layout_height="56dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_pdf"
                                android:tint="#000000" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AS PDF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginStart="8dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===================== SHARE SECTION ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

            <!-- Large Light Gray Squarish Capsule for Share Options -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F2F2F2"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:weightSum="3"
                    android:baselineAligned="false">

                    <!-- 1. Image Share White Capsule -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="4dp">
                        
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btn_share_image_action"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="#FFCDD2"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">
                            
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_share_image"
                                android:tint="#000000" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- 2. Text Share White Capsule -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp">
                        
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btn_share_text_action"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="#C8E6C9"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">
                            
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_text"
                                android:tint="#000000" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- 3. PDF Share White Capsule -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="4dp">
                        
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btn_share_pdf_action"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            app:cardBackgroundColor="#BBDEFB"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?android:attr/selectableItemBackground">
                            
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pdf"
                                android:tint="#000000" />
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>