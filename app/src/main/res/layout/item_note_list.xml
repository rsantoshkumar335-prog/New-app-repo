<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <!-- Modern Card Layout with Adaptive Height -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="132dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F4F4F4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="132dp"
            android:orientation="horizontal">

            <!-- Left Accent Color Strip -->
            <View
                android:id="@+id/color_strip"
                android:layout_width="14dp"
                android:layout_height="match_parent"
                android:background="#333333" />

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="132dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Text and List Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title + Pin Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="6dp">

                        <ImageView
                            android:id="@+id/iv_pin_badge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_pin"
                            android:tint="#111827"
                            android:visibility="gone"
                            android:contentDescription="Pinned note" />

                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="#0F172A"
                            android:textSize="17.5sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Content Wrapper -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#334155"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:maxLines="3"
                            android:ellipsize="end" />

                        <LinearLayout
                            android:id="@+id/ll_task_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_color_preview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Bottom Metadata Row: Category Badge + Task Progress + Date & Time -->
                    <LinearLayout
                        android:id="@+id/ll_date_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_category_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="General"
                            android:textColor="#1E293B"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_task_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="0/0"
                            android:textColor="#1E293B"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textStyle="bold"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Side Rounded Image Thumbnail -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_side_image"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="14dp"
                    android:layout_gravity="center_vertical"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_side_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Note attachment preview" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Selection Indicator Container -->
    <FrameLayout
        android:id="@+id/selection_indicator_container"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:elevation="5dp"
        android:visibility="gone">

        <View
            android:id="@+id/view_unselected_circle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_circle_outline"
            android:visibility="visible" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_selected_circle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:cardBackgroundColor="#0F172A"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_white"
                android:contentDescription="Selected" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</FrameLayout>