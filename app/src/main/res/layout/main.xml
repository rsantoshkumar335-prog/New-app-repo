<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:focusableInTouchMode="true">

    <!-- Modern Header Container -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="#1A000000"
        android:outlineSpotShadowColor="#1A000000"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="28dp"
        android:paddingBottom="12dp">

        <!-- TOP ROW: Title + Sort & View Toggle -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <!-- Brand & Live Productivity Stats -->
            <LinearLayout
                android:id="@+id/title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/header_actions_row"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_ink"
                        android:tint="#111827"
                        android:contentDescription="NotNote Logo" />

                    <TextView
                        android:id="@+id/tv_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="NotNote"
                        android:textColor="#111827"
                        android:textSize="28sp"
                        android:letterSpacing="-0.02"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_workspace_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="4dp"
                    android:text="Workspace ready"
                    android:textColor="#64748B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right Controls: Sort Button + View Toggle Capsule -->
            <LinearLayout
                android:id="@+id/header_actions_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Sort Button Pill -->
                <LinearLayout
                    android:id="@+id/btn_sort_notes"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_sort"
                        android:tint="#111827"
                        android:contentDescription="Sort notes" />

                    <TextView
                        android:id="@+id/tv_sort_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Newest"
                        android:textColor="#111827"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- List / Grid Toggle Capsule -->
                <LinearLayout
                    android:id="@+id/toggle_container"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_capsule_toggle"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/btn_view_list"
                        android:layout_width="42dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_toggle_selection"
                        android:padding="7dp"
                        android:src="@drawable/ic_list"
                        android:tint="#111827"
                        android:contentDescription="List view" />

                    <ImageView
                        android:id="@+id/btn_view_grid"
                        android:layout_width="42dp"
                        android:layout_height="34dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:src="@drawable/ic_grid"
                        android:tint="#111827"
                        android:contentDescription="Grid view" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- SEARCH CAPSULE -->
        <LinearLayout
            android:id="@+id/search_card"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_capsule_search"
            android:elevation="2dp"
            android:outlineAmbientShadowColor="#20000000"
            android:outlineSpotShadowColor="#10000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/icon_search"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="#64748B"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search title, text, #hex, or category..."
                android:singleLine="true"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:tint="#64748B"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:contentDescription="Clear search" />
        </LinearLayout>

        <!-- FLUID FILTER CHIPS ROW -->
        <HorizontalScrollView
            android:id="@+id/chip_scroll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:id="@+id/chip_group_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- EMPTY STATE CONTAINER -->
    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingBottom="100dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/ic_empty_notes"
            android:contentDescription="No notes illustration" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your workspace is clean"
            android:textColor="#0F172A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Capture rich notes, interactive task lists, math formulas, or start quickly with a template."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btn_empty_create"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="+ New Note"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_empty_template"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="⚡ Templates"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- SEARCH / FILTER EMPTY STATE CONTAINER -->
    <LinearLayout
        android:id="@+id/empty_search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:gravity="center_horizontal"
        android:paddingTop="72dp"
        android:paddingHorizontal="32dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:src="@drawable/ic_empty_search"
            android:contentDescription="No matching notes" />

        <TextView
            android:id="@+id/tv_empty_search_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No matching notes"
            android:textColor="#0F172A"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_empty_search_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Try another search keyword or switch the filter chip above"
            android:textColor="#64748B"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_container"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="140dp" />

    <!-- SMOKEY BOTTOM BACKGROUND EFFECT -->
    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_smokey_bottom" />

    <!-- MODERN FLOATING DOCK CAPSULE NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottom_dock_capsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_white_capsule"
        android:elevation="14dp"
        android:outlineAmbientShadowColor="#40000000"
        android:outlineSpotShadowColor="#26000000"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- 1. Add Note Button -->
        <FrameLayout
            android:id="@+id/btn_add_note"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ripple_capsule"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_add_plus"
                    android:tint="#0F172A"
                    android:contentDescription="Create Note" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Create"
                    android:textColor="#0F172A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Quick Templates Button -->
        <FrameLayout
            android:id="@+id/btn_quick_templates"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ripple_capsule"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_sparkle"
                    android:tint="#0F172A"
                    android:contentDescription="Quick Templates" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Templates"
                    android:textColor="#0F172A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Quick Private Vault Button -->
        <FrameLayout
            android:id="@+id/btn_quick_vault"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ripple_capsule"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_private"
                    android:tint="#0F172A"
                    android:contentDescription="Private Vault" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vault"
                    android:textColor="#0F172A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 4. Settings Button -->
        <RelativeLayout
            android:id="@+id/btn_settings"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_ripple_capsule"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    android:contentDescription="Settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Setting"
                    android:textColor="#0F172A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>